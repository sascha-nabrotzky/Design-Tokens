{
  "space": {
    "2": {
      "$value": "calc(2 / 16 * 1rem)",
      "$type": "spacing",
      "$description": "Haarlinien-Abstände, extrem feine UI-Tweakings. "
    },
    "4": {
      "$value": "calc(4 / 16 * 1rem)",
      "$type": "spacing",
      "$description": "Sehr kompakt. Perfekt für den Abstand zwischen Label und Input oder Badges."
    },
    "8": {
      "$value": "calc(8 / 16 * 1rem)",
      "$type": "spacing",
      "$description": "Die Basis-Einheit. Typischer Abstand zwischen Icon und Text oder Listen-Elementen. "
    },
    "12": {
      "$value": "calc(12 / 16 * 1rem)",
      "$type": "spacing",
      "$description": "Der harmonische Zwischenschritt für kompakte Paddings (z.B. in Tabellen). "
    },
    "16": {
      "$value": "calc(16 / 16 * 1rem)",
      "$type": "spacing",
      "$description": "Der globale Standard. Ideales Standard-Padding für Karten und Container. "
    },
    "24": {
      "$value": "calc(24 / 16 * 1rem)",
      "$type": "spacing",
      "$description": "Großzügiges Padding für größere Desktop-Komponenten oder Hero-Cards. "
    },
    "32": {
      "$value": "calc(32 / 16 * 1rem)",
      "$type": "spacing",
      "$description": "Beginn des Makro-Layouts. Abstand zwischen logischen Sektionen. "
    },
    "48": {
      "$value": "calc(48 / 16 * 1rem)",
      "$type": "spacing",
      "$description": "Großer Abstand. Perfekt für Grid-Gaps oder White-Space auf Landingpages. "
